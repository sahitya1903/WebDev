<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
    <style>
        table,tr,th{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
        </tr>
        <% for(let i=0;i<result.length;i++){%>
       <tr>
            <th><%= result[i].id %></th>
            <th><%= result[i].username %></th>
            <th><%= result[i].email %></th>
        </tr>
        <% } %>
    </table>
</body>
</html>